      "AssetCreate": {
        "properties": {
          "asset_type": {
            "$ref": "#/components/schemas/AssetType"
          },
          "currency": {
            "pattern": "^[A-Z]{3}$",
            "title": "Currency",
            "type": "string"
          },
          "exchange_mic": {
            "pattern": "^[A-Z0-9]{4}$",
            "title": "Exchange Mic",
            "type": "string"
          },
          "exchange_timezone": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 3,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exchange Timezone"
          },
          "isin": {
            "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$",
            "title": "Isin",
            "type": "string"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "provider_exchange_code": {
            "anyOf": [
              {
                "maxLength": 16,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Exchange Code"
          },
          "provider_symbol": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 3,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Symbol"
          },
          "sector": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sector"
          },
          "ticker": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Ticker",
            "type": "string"
          }
        },
        "required": [
          "name",
          "ticker",
          "isin",
          "exchange_mic",
          "currency",
          "asset_type"
        ],
        "title": "AssetCreate",
        "type": "object"
      },
