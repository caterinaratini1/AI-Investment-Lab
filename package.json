{
  "name": "ai-investment-lab",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/web",
    "packages/api_client"
  ],
  "engines": {
    "node": ">=24 <27"
  },
  "devDependencies": {
    "eslint": "10.9.1",
    "openapi-typescript": "7.13.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @ai-investment-lab/web",
    "build:web": "npm run build --workspace @ai-investment-lab/web",
    "generate:api-client": "openapi-typescript schemas/openapi.json -o packages/api_client/src/schema.d.ts",
    "lint:web": "npm run lint --workspace @ai-investment-lab/web",
    "test:web": "npm run test --workspace @ai-investment-lab/web",
    "typecheck:web": "npm run typecheck --workspace @ai-investment-lab/web"
  }
}
